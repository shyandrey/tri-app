# Optional future features. Do not copy real values into Git or any VITE_* key.
# Foundation works without this file. Copy to .dev.vars only when needed.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# TURNSTILE_SECRET_KEY=
# RATE_LIMIT_HMAC_SECRET=
# FEEDBACK_TELEGRAM_CHAT_ID=
# NEWS_TELEGRAM_CHANNEL_ID=
# ALLOWED_ORIGIN=http://localhost:8787
# Feedback protected environments additionally need public TURNSTILE_SITE_KEY,
# exact ALLOWED_ORIGIN and FEEDBACK_RATE_LIMITER binding (see docs/feedback.md).
# TURNSTILE_SITE_KEY=
# Local entry uses explicit mock delivery, never these real credentials.
