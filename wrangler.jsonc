{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tri-app-local",
  "main": "worker/local.ts",
  "compatibility_date": "2026-09-27",
  "workers_dev": false,
  "build": {"command": "npm run build", "watch_dir": ["src", "worker", "shared"]},
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "d1_databases": [{
    "binding": "DB", "database_name": "tri-app-local",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "env": {
    "preview": {
      "main": "worker/index.ts",
      "name": "tri-app-preview", "workers_dev": true,
      "vars": {
        "APP_ENV": "preview",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAFLWMQLuWNz_aJ5j",
        "ALLOWED_ORIGIN": "https://preview.300w.app"
      },
      "ratelimits": [{
        "name": "FEEDBACK_RATE_LIMITER",
        "namespace_id": "30001",
        "simple": { "limit": 5, "period": 60 }
      }],
      "triggers": { "crons": ["*/5 * * * *"] },
      "d1_databases": [{
        "binding": "DB", "database_name": "tri-app-preview",
        "database_id": "4dfe9210-0cc7-484f-8eea-fe5216f5c17a",
        "migrations_dir": "migrations"
      }]
    },
    "production": {
      "main": "worker/index.ts",
      "name": "tri-app", "workers_dev": true,
      "vars": { "APP_ENV": "production" },
      "d1_databases": [{
        "binding": "DB", "database_name": "tri-app-production",
        "database_id": "2b5cd1b9-d9bf-483d-b710-23d00b6db7fd",
        "migrations_dir": "migrations"
      }]
    }
  }
}
