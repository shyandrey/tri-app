{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tri-app-local",
  "main": "worker/local.ts",
  "compatibility_date": "2026-09-27",
  "workers_dev": false,
  "build": {"command": "npm run build", "watch_dir": ["src", "worker", "shared"]},
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "d1_databases": [{
    "binding": "DB", "database_name": "tri-app-local",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "env": {
    "preview": {
      "main": "worker/index.ts",
      "name": "tri-app-preview", "workers_dev": true,
      "d1_databases": [{
        "binding": "DB", "database_name": "tri-app-preview",
        "database_id": "11111111-1111-1111-1111-111111111111",
        "migrations_dir": "migrations"
      }]
    },
    "production": {
      "main": "worker/index.ts",
      "name": "tri-app", "workers_dev": true,
      "d1_databases": [{
        "binding": "DB", "database_name": "tri-app-production",
        "database_id": "22222222-2222-2222-2222-222222222222",
        "migrations_dir": "migrations"
      }]
    }
  }
}
