{
  "name": "tri-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.worker.json && vite build",
    "lint": "eslint .",
    "import:race-results": "node scripts/import-race-results.mjs",
    "audit:results": "node scripts/audit-results.mjs",
    "experiment:ranking": "node scripts/experiment-athlete-ranking.mjs",
    "collect:sof": "node scripts/collect-race-sof.mjs",
    "find:next-athletes": "node scripts/find-next-athletes.mjs",
    "import:athlete-photos": "node scripts/import-athlete-photos.mjs",
    "import:athlete-photos:all": "node scripts/import-athlete-photos.mjs --all",
    "preview": "vite preview",
    "audit:athlete-names": "node scripts/audit-athlete-names.mjs",
    "audit:athletes": "node scripts/audit-athletes.mjs",
    "enrich:athlete-countries": "node scripts/enrich-athlete-countries.mjs",
    "metadata": "node scripts/build-metadata.mjs",
    "predev": "npm run metadata",
    "prebuild": "npm run metadata",
    "cf:dev": "wrangler dev --local",
    "cf:migrate:local": "wrangler d1 migrations apply DB --local",
    "cf:check": "wrangler deploy --env \"\" --dry-run --outdir .wrangler/dry-run",
    "deploy:preview:dry": "wrangler deploy --env preview --dry-run",
    "deploy:preview": "wrangler deploy --env preview",
    "check:preview": "node scripts/check-preview.mjs",
    "pretest:foundation": "npm run metadata",
    "test:foundation": "node --test scripts/test-cloudflare-foundation.mjs",
    "test:feedback": "npm run metadata && node --test scripts/test-feedback.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260927.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.1",
    "wrangler": "^4.142.0"
  }
}
